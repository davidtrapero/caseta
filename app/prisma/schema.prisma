// Schema de Caseta — app privada back-office para gestión de casetas de feria.
// Ver plans/lanza-un-agente-arquitecto-optimized-finch.md para el análisis completo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// AUTH (Better Auth)
// =====================

enum Rol {
  admin
  gerente
  cajero
}

// Tipo de empleado — antes era enum PerfilEmpleado. Editable desde admin.
// `slug` es la clave estable usada por el código (p.ej. "voluntario").
// `colorHex` formato `#RRGGBB`. `esVoluntario` reemplaza la comparación
// `perfil === 'voluntario'` (un solo tipo debería tener este flag a true).
model TipoEmpleado {
  id           String   @id @default(cuid())
  slug         String   @unique
  label        String
  labelCorto   String
  colorHex     String
  orden        Int      @default(0)
  esVoluntario Boolean  @default(false)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empleados    Empleado[]
  plazas       TurnoPlaza[]
  casetasDefecto Caseta[]

  @@index([orden])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  rol           Rol       @default(cajero)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions               Session[]
  accounts               Account[]
  movimientos            MovimientoStock[]
  gastos                 Gasto[]
  auditLogs              AuditLog[]
  solicitudesDecididas   SolicitudVoluntario[]
  turnosSolicitudDecididos SolicitudVoluntarioTurno[] @relation("DecididasTurno")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// =====================
// DOMINIO
// =====================

// Edición de la feria (cada año). Raíz temporal — todo lo operativo cuelga de aquí.
model Edicion {
  id              String    @id @default(cuid())
  anio            Int       @unique
  nombre          String
  fechaInicio     DateTime  @db.Date
  fechaFin        DateTime  @db.Date
  activa          Boolean   @default(false)
  formularioToken String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  turnos                Turno[]
  cierres               CierreDiario[]
  gastos                Gasto[]
  pedidos               Pedido[]
  movimientos           MovimientoStock[]
  nominas               Nomina[]
  solicitudesVoluntario SolicitudVoluntario[]
}

// Caseta — transversal entre ediciones.
model Caseta {
  id                   String          @id @default(cuid())
  nombre               String          @unique
  ubicacion            String?
  activa               Boolean         @default(true)
  jornalDiarioDefault     Decimal?      @db.Decimal(10, 2)
  tipoEmpleadoDefectoId   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tipoEmpleadoDefecto TipoEmpleado? @relation(fields: [tipoEmpleadoDefectoId], references: [id], onDelete: SetNull)
  turnos       Turno[]
  productos    Producto[]
  stock        Stock[]
  movimientos  MovimientoStock[]
  pedidos      Pedido[]
  cierres      CierreDiario[]
  gastos       Gasto[]
}

// Empleado — recurso laboral.
// tipoEmpleado.esVoluntario ⇔ jornalDiario IS NULL (validado en Zod + lookup en action).
// tipoEmpleado.esVoluntario ⇔ entidadId NOT NULL (backfill en migración, refine en crearEmpleadoSchema).
model Empleado {
  id                 String         @id @default(cuid())
  nombre             String
  dni                String?        @unique
  telefono           String?
  email              String?
  jornalDiario       Decimal?       @db.Decimal(10, 2)
  tipoEmpleadoId     String
  entidadId          String?
  activo             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tipoEmpleado TipoEmpleado       @relation(fields: [tipoEmpleadoId], references: [id], onDelete: Restrict)
  entidad      EntidadVoluntario? @relation(fields: [entidadId], references: [id], onDelete: Restrict)
  asignaciones TurnoEmpleado[]
  nominas      Nomina[]

  @@index([tipoEmpleadoId])
}

// Tramo de trabajo en una caseta. fechaInicio/fechaFin son timestamps reales —
// permiten turnos que cruzan medianoche (20:00→02:00 del día siguiente).
// Fase 3: un turno puede tener de 0 a N empleados asignados (ver TurnoEmpleado).
// Se permite que exista sin asignaciones (placeholder para rellenar más tarde).
// Para nómina, el "día trabajado" es DATE(fechaInicio) (ver plans/).
// El solape entre turnos del mismo empleado se valida a nivel app (turnos-solape.ts).
model Turno {
  id          String   @id @default(cuid())
  edicionId   String
  casetaId    String
  fechaInicio DateTime
  fechaFin    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edicion               Edicion                   @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  caseta                Caseta                    @relation(fields: [casetaId], references: [id], onDelete: Restrict)
  asignaciones          TurnoEmpleado[]
  plazas                TurnoPlaza[]
  solicitudesVoluntario SolicitudVoluntarioTurno[]

  @@index([casetaId, fechaInicio])
  @@index([edicionId, fechaInicio])
}

// Plazas esperadas por perfil en un turno (asignación diferida).
// Permite planificar "necesito 1 vigilante + 4 trabajadores" antes de saber quién.
model TurnoPlaza {
  id             String @id @default(cuid())
  turnoId        String
  tipoEmpleadoId String
  cantidad       Int

  turno        Turno        @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  tipoEmpleado TipoEmpleado @relation(fields: [tipoEmpleadoId], references: [id], onDelete: Restrict)

  @@unique([turnoId, tipoEmpleadoId])
  @@index([tipoEmpleadoId])
}

// Asignación N:M Turno ↔ Empleado. asistio es por-empleado.
model TurnoEmpleado {
  id         String   @id @default(cuid())
  turnoId    String
  empleadoId String
  asistio    Boolean  @default(false)
  createdAt  DateTime @default(now())

  turno    Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@unique([turnoId, empleadoId])
  @@index([empleadoId])
}

// Catálogo por caseta.
model Producto {
  id        String   @id @default(cuid())
  casetaId  String
  nombre    String
  unidad    String   @default("unidad")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseta         Caseta            @relation(fields: [casetaId], references: [id], onDelete: Cascade)
  stock          Stock[]
  movimientos    MovimientoStock[]
  detallesPedido DetallePedido[]

  @@unique([casetaId, nombre])
}

// Stock actual por caseta y producto (desnormalizado para lecturas rápidas).
model Stock {
  id         String   @id @default(cuid())
  casetaId   String
  productoId String
  cantidad   Decimal  @db.Decimal(12, 3) @default(0)
  updatedAt  DateTime @updatedAt

  caseta   Caseta   @relation(fields: [casetaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([casetaId, productoId])
}

enum TipoMovimiento {
  entrada    // recepción de pedido
  ajuste     // ajuste manual por inventario físico
}

model MovimientoStock {
  id         String         @id @default(cuid())
  edicionId  String
  casetaId   String
  productoId String
  tipo       TipoMovimiento
  cantidad   Decimal        @db.Decimal(12, 3)
  fecha      DateTime       @default(now())
  usuarioId  String
  nota       String?

  edicion  Edicion  @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  caseta   Caseta   @relation(fields: [casetaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario  User     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([casetaId, productoId, fecha])
}

// Proveedores — transversales entre ediciones.
model Proveedor {
  id        String  @id @default(cuid())
  nombre    String  @unique
  contacto  String?
  email     String?
  telefono  String?
  activo    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos Pedido[]
}

enum EstadoPedido {
  pendiente
  recibido
  cancelado
}

model Pedido {
  id             String        @id @default(cuid())
  edicionId      String
  proveedorId    String
  casetaId       String
  fechaPedido    DateTime      @default(now())
  fechaRecepcion DateTime?
  estado         EstadoPedido  @default(pendiente)
  total          Decimal       @db.Decimal(12, 2) @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  edicion   Edicion         @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  proveedor Proveedor       @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  caseta    Caseta          @relation(fields: [casetaId], references: [id], onDelete: Restrict)
  detalles  DetallePedido[]

  @@index([estado])
}

model DetallePedido {
  id             String  @id @default(cuid())
  pedidoId       String
  productoId     String
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
}

// Cierre diario agregado (solo monto total del día por caseta).
model CierreDiario {
  id              String   @id @default(cuid())
  edicionId       String
  casetaId        String
  fecha           DateTime @db.Date
  ingresosTotales Decimal  @db.Decimal(12, 2)
  notas           String?
  bloqueado       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  edicion Edicion @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  caseta  Caseta  @relation(fields: [casetaId], references: [id], onDelete: Cascade)

  @@unique([casetaId, edicionId, fecha])
}

// Gastos — casetaId null ⇒ gasto transversal de la edición.
model Gasto {
  id          String   @id @default(cuid())
  edicionId   String
  casetaId    String?
  descripcion String
  monto       Decimal  @db.Decimal(12, 2)
  categoria   String
  fecha       DateTime @db.Date
  usuarioId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edicion Edicion @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  caseta  Caseta? @relation(fields: [casetaId], references: [id], onDelete: SetNull)
  usuario User    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([edicionId, fecha])
}

// Nómina — calculada como días_trabajados × jornalAplicado. Voluntarios excluidos.
model Nomina {
  id              String   @id @default(cuid())
  edicionId       String
  empleadoId      String
  diasTrabajados  Int
  jornalAplicado  Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(12, 2)
  pagada          Boolean  @default(false)
  fechaPago       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  edicion  Edicion  @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@unique([empleadoId, edicionId])
}

// Catálogo de entidades de voluntarios (hermandades, asociaciones, etc.).
// Borrado = soft-delete (activa=false). onDelete: Restrict en relaciones.
model EntidadVoluntario {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empleados   Empleado[]
  solicitudes SolicitudVoluntario[]

  @@index([activa, nombre])
}

enum EstadoSolicitud {
  pendiente
  aprobada
  rechazada
  parcial
  cancelada
}

enum EstadoSolicitudTurno {
  pendiente
  aprobado
  rechazado
}

model SolicitudVoluntario {
  id                String          @id @default(cuid())
  edicionId         String
  nombre            String
  telefono          String?
  email             String?
  entidadId         String
  observaciones     String?         @db.Text
  estado            EstadoSolicitud @default(pendiente)
  motivoRechazo     String?         @db.Text
  createdAt         DateTime        @default(now())
  decididaAt        DateTime?
  decididaPorUserId String?

  edicion     Edicion                    @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  entidad     EntidadVoluntario          @relation(fields: [entidadId], references: [id], onDelete: Restrict)
  decididaPor User?                      @relation(fields: [decididaPorUserId], references: [id], onDelete: SetNull)
  turnos      SolicitudVoluntarioTurno[]

  @@index([edicionId, estado])
  @@index([entidadId])
}

model SolicitudVoluntarioTurno {
  id          String @id @default(cuid())
  solicitudId String
  turnoId     String

  estado            EstadoSolicitudTurno @default(pendiente)
  motivoRechazo     String?              @db.Text
  decididaAt        DateTime?
  decididaPorUserId String?

  solicitud   SolicitudVoluntario @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  turno       Turno               @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  decididaPor User?               @relation("DecididasTurno", fields: [decididaPorUserId], references: [id], onDelete: SetNull)

  @@unique([solicitudId, turnoId])
  @@index([turnoId])
}

// Auditoría universal — escrita automáticamente por extensión Prisma.
model AuditLog {
  id        String   @id @default(cuid())
  entidad   String
  entidadId String
  accion    String   // create | update | delete
  usuarioId String?
  cambios   Json
  fecha     DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([fecha])
}
